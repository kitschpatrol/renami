{
	"name": "@kitschpatrol/renami",
	"version": "0.3.0",
	"description": "A CLI tool and TypeScript library for config-driven and content-aware automatic filename management.",
	"keywords": [
		"rename",
		"filename",
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/renami",
	"bugs": "https://github.com/kitschpatrol/renami/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/renami.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"renami": "dist/bin/cli.js"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"coverage": "vitest run --coverage",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"@sindresorhus/is": "^8.1.0",
		"@stdlib/assert-is-absolute-path": "^0.2.3",
		"@types/mdast": "^4.0.4",
		"cosmiconfig": "^10.0.0",
		"cosmiconfig-typescript-loader": "^6.3.0",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"deepmerge-ts": "^8.0.2",
		"escape-string-regexp": "^5.0.0",
		"filenamify": "~6.0.0",
		"github-slugger": "^2.0.0",
		"globby": "^16.2.4",
		"mdast-util-to-string": "^4.0.0",
		"nanoid": "^6.0.1",
		"natural-orderby": "^5.0.0",
		"numerable": "^0.3.15",
		"pathe": "^2.0.3",
		"picocolors": "^1.1.1",
		"pretty-ms": "^9.3.1",
		"property-expr": "^2.0.6",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"unist-util-select": "^5.1.0",
		"vfile": "^6.0.3",
		"vfile-matter": "^5.0.1",
		"yargs": "^18.1.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.7.0",
		"@types/node": "~24.13.3",
		"@types/yargs": "^17.0.35",
		"@vvo/tzdb": "^6.198.0",
		"bumpp": "^12.2.2",
		"mdat-plugin-cli-help": "^3.2.0",
		"shx": "^0.4.0",
		"tsdown": "^0.22.14",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24.16.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
